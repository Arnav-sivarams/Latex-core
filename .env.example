# Copy to .env and replace every placeholder before `docker compose up -d --build`.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://latex_core:replace-with-a-long-random-password@postgres:5432/latex_core
POSTGRES_DB=latex_core
POSTGRES_USER=latex_core
HTTP_PORT=8080
# Development HTTP only; set true behind TLS.
SESSION_COOKIE_SECURE=false
# Must be the immutable digest/ID and environment ID from the frozen M7 image.
COMPILER_IMAGE=latex-core-texlive@sha256:REPLACE_WITH_M7_IMAGE_DIGEST
TEX_ENVIRONMENT_ID=REPLACE_WITH_M7_ENVIRONMENT_ID
WORKER_CONCURRENCY=1
WORKER_STAGING_HOST_ROOT=/tmp/latex-core-worker-staging
QUEUE_GLOBAL_RUNNING=2
QUEUE_PER_USER_RUNNING=1
QUEUE_PER_USER_OUTSTANDING=8
