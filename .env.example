# Safe local defaults. Run ./scripts/generate-local-env.sh rather than copying
# this file so private values are generated with system randomness.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://latex_core:replace-with-a-long-random-password@postgres:5432/latex_core
POSTGRES_DB=latex_core
POSTGRES_USER=latex_core
LATEX_CORE_POSTGRES_PORT=54329
HTTP_PORT=8080
COMPOSE_PROJECT_NAME=latex-core
# Development HTTP only; set true behind TLS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
ALLOW_REGISTRATION=false
# Runtime always uses the immutable local M7 image ID. The source tag is
# installer metadata used only when the local image is absent.
COMPILER_IMAGE=sha256:8db804f76b8e80e5be9fb28ba14b0938df5989b7a8250ca6b0e9f3c200c4ee38
TEX_ENVIRONMENT_ID=texlive-2026-sha256-364cea85dc8ba5e2a5131f1d8088142d08c9733d24d2644880d6eae86f751d5a
LATEX_CORE_M7_IMAGE_SOURCE=ghcr.io/arnav-sivarams/latex-core-texlive:2026-m7
WORKER_CONCURRENCY=1
WORKER_STAGING_HOST_ROOT=/tmp/latex-core-worker-staging
QUEUE_GLOBAL_RUNNING=2
QUEUE_PER_USER_RUNNING=1
QUEUE_PER_USER_OUTSTANDING=8
QUEUE_LEASE_SECONDS=120
QUEUE_MAX_ATTEMPTS=3

# Temporary-credential email. Disabled deployments preserve the credentials CSV fallback.
LATEX_CORE_MAIL_ENABLED=false
# Required only when mail is enabled. Use provider-neutral SMTP settings.
LATEX_CORE_SMTP_HOST=smtp.example.edu
LATEX_CORE_SMTP_PORT=587
LATEX_CORE_SMTP_USERNAME=
LATEX_CORE_SMTP_PASSWORD=
LATEX_CORE_SMTP_FROM_EMAIL=latex-core@example.edu
LATEX_CORE_SMTP_FROM_NAME=LaTeX Core
# Accepted values: starttls (usually port 587) or tls (usually port 465).
LATEX_CORE_SMTP_SECURITY=starttls
LATEX_CORE_PUBLIC_BASE_URL=http://localhost:8080
# Exactly 32 random bytes, standard base64 encoded; generated locally.
LATEX_CORE_MAIL_SECRET_KEY=replace-with-base64-encoded-32-byte-random-key
LATEX_CORE_MAIL_SECRET_LIFETIME_HOURS=72
LATEX_CORE_MAIL_BATCH_SIZE=20
LATEX_CORE_MAIL_MAX_ATTEMPTS=5
